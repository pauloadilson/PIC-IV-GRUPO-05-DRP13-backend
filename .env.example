# Porta do servidor Express
PORT=3001

# Origens permitidas do Front-end separadas por virgula (ex: http://localhost:5173,https://seu-frontend.vercel.app)
ALLOWED_ORIGINS=

# Chave de seguranca exclusiva entre o seu Front-end e este Back-end
BACKEND_API_KEY=
VALIDAR_BACKEND_API_KEY=true

# URL local da API coletora (pic-iv-api)
PIC_API_URL=

# URL remota da API coletora publicada na nuvem
REMOTE_PIC_API_URL=

# Chave de autenticacao da API coletora (opcional, caso VALIDAR_API_KEY=true na pic-iv-api)
PIC_API_KEY=
